################################################################################
### 6. SUPERSET & MULTI-TENANT RLS İZOLASYONU (S8)
# Tek Superset (localhost:8088), tek DB (ff_logistics_analytics).
# Guest token'ı Identity (localhost:8085) imzalar; Superset DB bağlantısında
# SET app.tenant_id = '<token-tenant>' çalıştırır.
################################################################################

### 6.1 Negatif Güvenlik Testi: EU kullanıcısı TR tenant'ı için guest token isterse -> 403 Forbidden!
POST {{identity}}/api/v1/guest-tokens
Authorization: Bearer {{euToken}}
Content-Type: application/json

{
  "dashboardId": "{{dashboardId}}",
  "tenantId": "ff-tr-distribution"
}

> {%
    client.test("Cross-tenant guest token refused with 403", () => client.assert(response.status === 403, "Expected 403"));
%}

### 6.2 EU tenant'ı (ff-eu-freight) için Superset Guest Token al
POST {{identity}}/api/v1/guest-tokens
Authorization: Bearer {{euToken}}
Content-Type: application/json

{
  "dashboardId": "{{dashboardId}}"
}

> {%
    client.test("EU guest token issued", () => client.assert(response.status === 200, "Expected 200"));
    client.global.set("euGuestToken", response.body.token);
%}

### 6.3 TR tenant'ı (ff-tr-distribution) için Superset Guest Token al
POST {{identity}}/api/v1/guest-tokens
Authorization: Bearer {{trToken}}
Content-Type: application/json

{
  "dashboardId": "{{dashboardId}}"
}

> {%
    client.test("TR guest token issued", () => client.assert(response.status === 200, "Expected 200"));
    client.global.set("trGuestToken", response.body.token);
%}

### 6.4 Superset Chart'ını EU Guest Token ile sorgula -> ff-eu-freight teslimat sayısını döner!
POST {{superset}}/api/v1/chart/data
X-GuestToken: {{euGuestToken}}
Content-Type: application/json

{
  "datasource": { "id": 1, "type": "table" },
  "force": true,
  "queries": [
    {
      "columns": [
        {
          "columnType": "BASE_AXIS",
          "sqlExpression": "delivery_month",
          "label": "delivery_month",
          "expressionType": "SQL",
          "timeGrain": "P1M"
        }
      ],
      "metrics": ["delivered_shipments"],
      "orderby": [["delivered_shipments", false]],
      "row_limit": 100
    }
  ],
  "result_format": "json",
  "result_type": "full",
  "form_data": {
    "slice_id": 1,
    "dashboardId": 1,
    "viz_type": "echarts_timeseries_bar"
  }
}

> {%
    client.test("EU chart returns 200", () => client.assert(response.status === 200, "Expected 200"));
%}

### 6.5 Aynı Superset Chart'ını TR Guest Token ile sorgula -> EU verisini GÖREMEZ ([] veya sadece TR satırları)!
POST {{superset}}/api/v1/chart/data
X-GuestToken: {{trGuestToken}}
Content-Type: application/json

{
  "datasource": { "id": 1, "type": "table" },
  "force": true,
  "queries": [
    {
      "columns": [
        {
          "columnType": "BASE_AXIS",
          "sqlExpression": "delivery_month",
          "label": "delivery_month",
          "expressionType": "SQL",
          "timeGrain": "P1M"
        }
      ],
      "metrics": ["delivered_shipments"],
      "orderby": [["delivered_shipments", false]],
      "row_limit": 100
    }
  ],
  "result_format": "json",
  "result_type": "full",
  "form_data": {
    "slice_id": 1,
    "dashboardId": 1,
    "viz_type": "echarts_timeseries_bar"
  }
}

> {%
    client.test("TR chart returns 200", () => client.assert(response.status === 200, "Expected 200"));
%}

################################################################################
### 7. (OPSİYONEL) TR TENANT'I İÇİN DE BİR TESLİMAT YAP VE SUPERSET'TE FARKI GÖR!
# 7.1 + 7.2'yi çalıştırıp 2-3 sn sonra tekrar 6.5'i çalıştırırsan TR'nin kendi
# teslimat sayısının arttığını, EU'nun sayısının değişmediğini görürsün.
################################################################################

### 7.1 TR Tenant (ff-tr-distribution) için Shipment planla
POST {{edge}}/api/v1/tms/shipments
Authorization: Bearer {{trToken}}
Content-Type: application/json

{
  "consignorName": "Anadolu Dagitim AS",
  "consigneeName": "Izmir Liman Depo",
  "equipmentCode": "CSQU3054383",
  "sscc": "106141411234567897",
  "incoterm": "DAP",
  "origin": "Ankara Lojistik Ussu",
  "destination": "Izmir Kemalpasa",
  "grossWeightKg": 12000,
  "legs": [
    {
      "mode": "RAIL",
      "origin": "Ankara Lojistik Ussu",
      "destination": "Izmir Alsancak",
      "distanceKm": 580,
      "carrierReference": "TCDD-TR-2026"
    },
    {
      "mode": "ROAD",
      "origin": "Izmir Alsancak",
      "destination": "Izmir Kemalpasa",
      "distanceKm": 35,
      "carrierReference": "TR-35-FF-0101"
    }
  ]
}

> {%
    client.test("TR shipment planned", () => client.assert(response.status === 201, "Expected 201"));
    client.global.set("trShipmentId", response.body.id);
%}

### 7.2 TR Tenant Shipment'ını teslim et (sonra 6.4 ve 6.5'i tekrar çalıştır!)
POST {{edge}}/api/v1/tms/shipments/{{trShipmentId}}/delivery
Authorization: Bearer {{trToken}}
Content-Type: application/json

{
  "receivedBy": "Izmir Dock 1"
}

> {%
    client.test("TR shipment delivered", () => client.assert(response.status === 200, "Expected 200"));
%}
