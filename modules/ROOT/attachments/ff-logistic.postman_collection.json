        {
          "name": "2.5 Receive Pallet #1 (60 pcs — RECEIVING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pallet received (201)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{euToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gtin\": \"8690001100018\",\n  \"quantity\": 60,\n  \"grossWeightKg\": 180.5,\n  \"binCode\": \"A-01-01\"\n}"
            },
            "url": "{{edge}}/api/v1/wms/asns/{{asnId}}/pallets"
          }
