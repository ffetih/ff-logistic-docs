    {
      "name": "3. Transportation (TMS) + Flow 2 + Kafka + Analytics (S4 & S6)",
      "description": "Multimodal sevkiyat planla ve teslim et. Outbox -> Kafka (ff.logistics.tms.shipment-delivered) -> WMS Inbound Arrival + Analytics Loader.",
      "item": [
        {
          "name": "3.1 Plan Multimodal Shipment (Cologne -> Istanbul)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Shipment planned (201)', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('shipmentId', body.id);",
                  "pm.collectionVariables.set('shipmentNumber', body.shipmentNumber);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{euToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consignorName\": \"Rhein Parts GmbH\",\n  \"consigneeName\": \"Istanbul Hadimkoy Hub\",\n  \"destinationGln\": \"8690001000011\",\n  \"equipmentCode\": \"CSQU3054383\",\n  \"sscc\": \"106141411234567897\",\n  \"incoterm\": \"DAP\",\n  \"origin\": \"Cologne Eifeltor\",\n  \"destination\": \"Istanbul Hadimkoy\",\n  \"grossWeightKg\": 18000,\n  \"legs\": [\n    { \"mode\": \"ROAD\", \"origin\": \"Cologne Eifeltor\", \"destination\": \"Cologne Eifeltor Terminal\", \"distanceKm\": 15, \"carrierReference\": \"DE-K-FF-210\" },\n    { \"mode\": \"RAIL\", \"origin\": \"Cologne Eifeltor Terminal\", \"destination\": \"Trieste\", \"distanceKm\": 1050, \"carrierReference\": \"TXL-41877\" },\n    { \"mode\": \"SEA_RORO\", \"origin\": \"Trieste\", \"destination\": \"Istanbul Pendik\", \"distanceKm\": 1450, \"carrierReference\": \"DFDS-PT-2611\" },\n    { \"mode\": \"ROAD\", \"origin\": \"Istanbul Pendik\", \"destination\": \"Istanbul Hadimkoy\", \"distanceKm\": 60, \"carrierReference\": \"TR-34-FF-0417\" }\n  ]\n}"
