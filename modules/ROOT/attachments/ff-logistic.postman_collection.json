    {
      "name": "2. Warehousing (WMS — S3)",
      "description": "Depo (IST-HDK), raf (A-01-01), ASN ve GS1 SSCC etiketli palet kabulü. DB: ff_logistics (wms_*).",
      "item": [
        {
          "name": "2.1 Create Warehouse (IST-HDK, 201 or 409 if exists)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created (201) or already exists (409)', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('warehouseId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{euToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"IST-HDK\",\n  \"name\": \"Istanbul Hadimkoy Hub\",\n  \"gln\": \"8690001000011\",\n  \"gs1CompanyPrefix\": \"8690001\",\n  \"countryCode\": \"TR\",\n  \"city\": \"Istanbul\",\n  \"latitude\": 41.1025,\n  \"longitude\": 28.6512,\n  \"palletCapacity\": 12000\n}"
            },
            "url": "{{edge}}/api/v1/wms/warehouses"
          }
        },
        {
          "name": "2.2 List Warehouses (Resolve IST-HDK ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Warehouses listed', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "const wh = list.find(w => w.code === 'IST-HDK') || list[0];",
                  "if (wh) pm.collectionVariables.set('warehouseId', wh.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{euToken}}" }
            ],
            "url": "{{edge}}/api/v1/wms/warehouses"
          }
        },
        {
          "name": "2.3 Create Bin (A-01-01, 201 or 409 if exists)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created (201) or already exists (409)', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{euToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"A-01-01\",\n  \"kind\": \"RACK\",\n  \"palletCapacity\": 4\n}"
            },
            "url": "{{edge}}/api/v1/wms/warehouses/{{warehouseId}}/bins"
          }
        },
        {
          "name": "2.4 Create ASN (Unique Timestamp)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ASN created (201)', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('asnId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{euToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asnNumber\": \"ASN-2026-{{$timestamp}}\",\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"supplierName\": \"Anatolia Textiles\",\n  \"expectedArrival\": \"2026-11-25\",\n  \"lines\": [\n    {\n      \"gtin\": \"8690001100018\",\n      \"skuCode\": \"TSHIRT-M-BLUE\",\n      \"quantity\": 120\n    }\n  ]\n}"
            },
            "url": "{{edge}}/api/v1/wms/asns"
