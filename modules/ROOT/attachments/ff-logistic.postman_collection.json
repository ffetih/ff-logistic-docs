    {
      "name": "1. Identity (Auth — EU & TR)",
      "description": "Keycloak üzerinden iki ayrı tenant için JWT access token alır (5 dk geçerli).",
      "item": [
        {
          "name": "1.1 EU Login (ff-eu-freight — nexus.planner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('EU login 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('euToken', body.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{euUser}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{identity}}/sessions"
          }
        },
        {
          "name": "1.2 TR Login (ff-tr-distribution — geodispatch.operator)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TR login 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('trToken', body.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{trUser}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{identity}}/sessions"
          }
        },
        {
          "name": "1.3 Who Am I (/api/v1/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and tenant is ff-eu-freight', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().tenantId).to.eql('ff-eu-freight');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{euToken}}" }
