              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pallet received and ASN complete', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().asnStatus).to.eql('RECEIVED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{euToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gtin\": \"8690001100018\",\n  \"quantity\": 60,\n  \"grossWeightKg\": 180.5,\n  \"binCode\": \"A-01-01\"\n}"
            },
            "url": "{{edge}}/api/v1/wms/asns/{{asnId}}/pallets"
          }
        },
        {
          "name": "2.7 Get ASN Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{euToken}}" }
