    {
      "name": "4. Routing (GEO) + Flow 1 + Flow 3 (S5)",
      "description": "Territory, Timefold zaman pencereli optimizasyon, Flow 1 (Transportation -> Routing mesafe sorgusu) ve Flow 3 (1 durak tamamlama ile Routing -> Transportation -> Warehousing + Analytics).",
      "item": [
        {
          "name": "4.1 Create Territory (IST-EU, 201 or 409 if exists)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created (201) or already exists (409)', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
